const gradients = [
"linear-gradient(135deg, #1e293b, #0f172a)",
"linear-gradient(135deg, #1e1b4b, #0f172a)",
"linear-gradient(135deg, #172554, #090d16)",
"linear-gradient(135deg, #064e3b, #090d16)",
"linear-gradient(135deg, #3b0764, #090d16)",
"linear-gradient(135deg, #4c0519, #090d16)"
];
const grid = document.getElementById("gameGrid");
const searchInput = document.getElementById("searchInput");
const resultCount = document.getElementById("resultCount");
const catButtons = document.querySelectorAll(".cat-btn");
let currentCategory = "All";
let searchQuery = "";
let gameLoop = null;
function renderGames() {
grid.innerHTML = "";
const filtered = games.filter(g => {
const matchesCat = currentCategory === "All" || g.cat === currentCategory;
const matchesSearch = g.title.toLowerCase().includes(searchQuery.toLowerCase());
return matchesCat && matchesSearch;
});
resultCount.textContent = Showing ${filtered.length} game${filtered.length === 1 ? "" : "s"};
filtered.forEach((game, idx) => {
const card = document.createElement("div");
card.className = "game-card";
const bg = gradients[idx % gradients.length];
card.innerHTML = <div class="thumb" style="background: ${bg}"> ${game.hot ? '<span class="badge">HOT</span>' : ''} <span>${game.icon}</span> </div> <div class="card-body"> <div class="card-title">${game.title}</div> <div class="card-cat">${game.cat}</div> </div>;
card.onclick = () => launchGame(game);
grid.appendChild(card);
});
}
// Category filter click
catButtons.forEach(btn => {
btn.onclick = () => {
catButtons.forEach(b => b.classList.remove("active"));
btn.classList.add("active");
currentCategory = btn.dataset.cat;
renderGames();
};
});
// Search filter input
searchInput.oninput = (e) => {
searchQuery = e.target.value;
renderGames();
};
// Launch Game Modal
function launchGame(game) {
cancelAnimationFrame(gameLoop);
document.getElementById("modalTitle").textContent = ${game.icon} ${game.title};
document.getElementById("modalCat").textContent = game.cat;
const viewport = document.getElementById("playerViewport");
document.getElementById("playerModal").classList.add("open");
// If you add a real embed URL to a game object, it loads in an iframe:
if (game.url) {
viewport.innerHTML = <iframe class="game-frame" src="${game.url}" allowfullscreen></iframe>;
return;
}
// Otherwise, launch an instant playable platformer/runner mini-game so every card works!
viewport.innerHTML = <div style="color:#94a3b8; font-size:0.85rem; margin-bottom:0.6rem;"> Press <strong>SPACE</strong> or <strong>CLICK</strong> to jump! (Replace <code>url</code> in code to embed the full game) </div> <canvas id="builtin-canvas" width="760" height="380"></canvas>;
startMiniRunner(game);
}
// Built-in playable parkour runner (OvO-style stick/box jumper)
function startMiniRunner(game) {
const canvas = document.getElementById("builtin-canvas");
const ctx = canvas.getContext("2d");
let player = { x: 90, y: 280, w: 28, h: 38, dy: 0, jumpPower: -12, grounded: true };
let gravity = 0.65;
let obstacles = [];
let score = 0;
let speed = 5.5;
let frame = 0;
let gameOver = false;
function jump() {
if (gameOver) {
startMiniRunner(game);
return;
}
if (player.grounded) {
player.dy = player.jumpPower;
player.grounded = false;
}
}
window.onkeydown = (e) => {
if (e.code === "Space" || e.code === "ArrowUp") jump();
};
canvas.onclick = jump;
function update() {
ctx.clearRect(0, 0, canvas.width, canvas.height);
// Ground
ctx.fillStyle = "#1e293b";
ctx.fillRect(0, 318, canvas.width, 62);
// Title watermark
ctx.fillStyle = "rgba(148, 163, 184, 0.15)";
ctx.font = "bold 42px sans-serif";
ctx.textAlign = "center";
ctx.fillText(game.title.toUpperCase(), canvas.width / 2, 180);
if (!gameOver) {
frame++;
score = Math.floor(frame / 6);
speed = 5.5 + score * 0.005;
// Player physics
player.dy += gravity;
player.y += player.dy;
if (player.y >= 280) {
player.y = 280;
player.dy = 0;
player.grounded = true;
}
// Spawn obstacles
if (frame % 75 === 0) {
obstacles.push({ x: canvas.width, y: 288, w: 24, h: 30 });
}
// Move & check collisions
for (let i = obstacles.length - 1; i >= 0; i--) {
let obs = obstacles[i];
obs.x -= speed;
ctx.fillStyle = "#f43f5e";
ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
if (
player.x < obs.x + obs.w &&
player.x + player.w > obs.x &&
player.y < obs.y + obs.h &&
player.y + player.h > obs.y
) {
gameOver = true;
}
if (obs.x + obs.w < 0) obstacles.splice(i, 1);
}
}
// Draw Player
ctx.fillStyle = "#38bdf8";
ctx.fillRect(player.x, player.y, player.w, player.h);
// Score HUD
ctx.fillStyle = "#f8fafc";
ctx.font = "bold 18px sans-serif";
ctx.textAlign = "left";
ctx.fillText(Score: ${score}, 20, 35);
if (gameOver) {
ctx.fillStyle = "rgba(9, 13, 22, 0.8)";
ctx.fillRect(0, 0, canvas.width, canvas.height);
ctx.fillStyle = "#f8fafc";
ctx.textAlign = "center";
ctx.font = "bold 28px sans-serif";
ctx.fillText("Game Over!", canvas.width / 2, 175);
ctx.font = "16px sans-serif";
ctx.fillStyle = "#38bdf8";
ctx.fillText(Final Score: ${score} — Click or press Space to restart, canvas.width / 2, 210);
}
gameLoop = requestAnimationFrame(update);
}
update();
}
function closeModal() {
cancelAnimationFrame(gameLoop);
document.getElementById("playerModal").classList.remove("open");
document.getElementById("playerViewport").innerHTML = "";
}
function toggleFullscreen() {
const box = document.getElementById("playerBox");
if (!document.fullscreenElement) {
box.requestFullscreen().catch(() => {});
} else {
document.exitFullscreen();
}
}
renderGames();
